{
  "name": "autocrat-erp-work-order-planning",
  "description": "Autocrat ERP – Work Order Planning, Stock Allocation & PPC module (React + TypeScript + Vite)",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node backend/server.js\" \"vite frontend --port=3002 --host=0.0.0.0\"",
    "dev:frontend": "vite frontend --port=3002 --host=0.0.0.0",
    "server": "node backend/server.js",
    "db:clear": "node backend/scripts/clearDb.js",
    "build": "tsc --noEmit -p frontend/tsconfig.json && vite build frontend",
    "preview": "vite preview frontend",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit -p frontend/tsconfig.json"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@google/genai": "^2.4.0",
    "@radix-ui/react-slot": "^1.2.3",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "better-sqlite3": "^13.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "concurrently": "^10.0.4",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "mime-db": "^1.54.0",
    "motion": "^12.23.24",
    "pg": "^8.16.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.8.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}